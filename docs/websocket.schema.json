            },
            "seq": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "chat_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "type",
            "seq",
            "chat_id",
            "data",
            "message_id"
          ],
