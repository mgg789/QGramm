{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QGramm WebSocket JSON frames",
  "description": "Client sends subscribe/unsubscribe. Server sends durable Event or error frames. No WS ack message: use POST /v1/chats/{chat}/receipts HTTP delivered/read cursors. Replay after reconnect uses subscribe.after; 410/sync.error requires HTTP history/state recovery. Ping/pong are WebSocket control frames, not JSON.",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "Envelope": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string"
        },
        "enc": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "ciphertext": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "key_id",
        "enc",
        "ciphertext"
      ],
      "additionalProperties": false
    },
    "MessageInput": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "envelope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Envelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "mls": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "epoch": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reply_to": {
          "type": "string"
        },
        "forward_from": {
          "type": "string"
        }
      },
      "required": [
        "operation_id"
      ],
      "additionalProperties": false,
      "description": "basic requires envelope; e2ee requires MLS PrivateMessage and current epoch. Attachment/reply/forward fields require compiled features. No plaintext JSON payload field."
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "deleted": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "basic",
            "e2ee"
          ]
        },
        "epoch": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "envelope": {
          "$ref": "#/$defs/Envelope"
        },
        "mls": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reply_to": {
          "type": "string"
        },
        "forward_from": {
          "type": "string"
        },
        "reactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reaction"
          }
        }
      },
      "required": [
        "id",
        "chat_id",
        "sender",
        "device_id",
        "operation_id",
        "seq",
        "revision",
        "deleted",
        "mode",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Reaction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "user_id"
      ],
      "additionalProperties": false
    },
    "AcceptanceReceipt": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        }
      },
      "required": [
        "message_id",
        "chat_id",
        "operation_id",
        "seq"
      ],
      "additionalProperties": false
    },
    "SendResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "message": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "status",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "receipt": {
              "$ref": "#/$defs/AcceptanceReceipt"
            }
          },
          "required": [
            "status",
            "receipt"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Chat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "direct",
            "group"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "basic",
            "e2ee"
          ]
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "epoch": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "pending_rekey": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "admin",
            "member"
          ]
        },
        "can_send": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "mode",
        "seq",
        "epoch",
        "pending_rekey",
        "role",
        "can_send"
      ],
      "additionalProperties": false
    },
    "RosterMember": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "leaf_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "device_id",
        "leaf_index"
      ],
      "additionalProperties": false
    },
    "ChunkBinding": {
      "type": "object",
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "chat_id",
        "user_id",
        "device_id",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "MembershipEvent": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "can_send": {
          "type": "boolean"
        }
      },
      "required": [
        "user_id",
        "active",
        "can_send"
      ],
      "additionalProperties": false
    },
    "ReceiptEvent": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "delivered": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "read": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        }
      },
      "required": [
        "user_id",
        "device_id",
        "delivered",
        "read"
      ],
      "additionalProperties": false
    },
    "ReactionEvent": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "type": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "remove": {
          "type": "boolean"
        }
      },
      "required": [
        "message_id",
        "user_id",
        "type",
        "remove"
      ],
      "additionalProperties": false
    },
    "MLSCommitEvent": {
      "type": "object",
      "properties": {
        "transition_id": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "commit_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "transition_id",
        "epoch",
        "commit_hash"
      ],
      "additionalProperties": false
    },
    "MLSEpochEvent": {
      "type": "object",
      "properties": {
        "transition_id": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "roster": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RosterMember"
          }
        }
      },
      "required": [
        "transition_id",
        "epoch",
        "roster"
      ],
      "additionalProperties": false
    },
    "AIIdentityEvent": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic"
          ]
        }
      },
      "required": [
        "user_id",
        "device_id",
        "provider"
      ],
      "additionalProperties": false
    },
    "CallRingingEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "caller": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "audio",
            "video"
          ]
        }
      },
      "required": [
        "id",
        "caller",
        "mode"
      ],
      "additionalProperties": false
    },
    "CallSignalEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "envelope": {
          "$ref": "#/$defs/Envelope"
        },
        "to_device": {
          "type": "string"
        },
        "to_user": {
          "type": "string"
        },
        "mls": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "epoch": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "enum": [
            "accept",
            "reject",
            "end",
            "offer",
            "answer",
            "ice"
          ]
        }
      },
      "required": [
        "id",
        "sender",
        "device_id",
        "operation_id",
        "type"
      ],
      "additionalProperties": false
    },
    "CallTimeoutEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "timeout"
          ]
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "additionalProperties": false
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "message.created"
            },
            "seq": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "chat_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "type",
            "seq",
            "chat_id",
            "data",
            "message_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "message.edited"
            },
            "seq": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "chat_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "type",
            "seq",
            "chat_id",
            "data",
            "message_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "message.deleted"
            },
            "seq": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "chat_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "type",
            "seq",
            "chat_id",
            "data",
            "message_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "message.hidden"
            },
            "seq": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "chat_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/Message"
            }
          },
          "required": [
            "type",
            "seq",
            "chat_id",
            "data",
            "message_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
