              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "chat_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/MembershipEvent"
            }
          },
          "required": [
            "type",
            "seq",
            "chat_id",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "receipt.updated"
            },
            "seq": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "chat_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/ReceiptEvent"
            }
          },
          "required": [
