+package core
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"testing"
+)
+
+func TestBatchPrepareSnapshotFreshTransactionGuards(t *testing.T) {
+	for _, change := range []string{"UPDATE devices SET revoked=1 WHERE id='alice-phone'", "UPDATE members SET can_send=0 WHERE user_id='alice'", "UPDATE chats SET epoch=epoch+1 WHERE id='chat'", "UPDATE chats SET pending=1 WHERE id='chat'"} {
+		t.Run(change, func(t *testing.T) {
+			f := newFixture(t)
+			ctx := context.Background()
+			input := f.input(t, "fresh-guard", "hello")
+			snapshot := f.c.loadBatchPrepare(ctx, f.id, "chat", []MessageInput{input})
+			job, _, err := f.c.prepareMessageWithSnapshot(ctx, f.id, "chat", input, snapshot)
+			if err != nil || job == nil {
+				t.Fatal(job, err)
+			}
+			if _, err := f.c.DB.Exec(change); err != nil {
+				t.Fatal(err)
+			}
+			result := f.c.submitPrepared([]messageWriteJob{*job})[0]
+			var api *APIError
+			if !errors.As(result.err, &api) || api.Status != 403 && api.Status != 409 {
+				t.Fatal(result.err)
+			}
+			var count int
+			if err := f.c.DB.QueryRow("SELECT COUNT(*) FROM messages").Scan(&count); err != nil || count != 0 {
+				t.Fatal(count, err)
+			}
+		})
+	}
+}
+
+func TestBatchPrepareSnapshotConcurrentOperation(t *testing.T) {
+	for _, conflict := range []bool{false, true} {
+		t.Run(fmt.Sprint(conflict), func(t *testing.T) {
+			f := newFixture(t)
+			ctx := context.Background()
+			input := f.input(t, "concurrent-op", "hello")
+			snapshot := f.c.loadBatchPrepare(ctx, f.id, "chat", []MessageInput{input})
+			job, _, err := f.c.prepareMessageWithSnapshot(ctx, f.id, "chat", input, snapshot)
+			if err != nil {
+				t.Fatal(err)
+			}
+			other := input
+			if conflict {
+				other = f.input(t, input.OperationID, "changed")
+			}
+			saved, err := f.c.Send(ctx, f.id, "chat", other)
+			if err != nil {
+				t.Fatal(err)
+			}
+			result := f.c.submitPrepared([]messageWriteJob{*job})[0]
+			if conflict {
+				var api *APIError
+				if !errors.As(result.err, &api) || api.Status != 409 {
+					t.Fatal(result.err)
+				}
+			} else if result.err != nil || !result.repeated || result.message.ID != saved.ID {
+				t.Fatal(result)
+			}
+		})
+	}
+}
+
+func TestBatchPrepareSnapshotCorruptResultIsolation(t *testing.T) {
+	f := newFixture(t)
+	ctx := context.Background()
+	bad := f.input(t, "bad-result", "a")
+	if _, err := f.c.Send(ctx, f.id, "chat", bad); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := f.c.DB.Exec("UPDATE operations SET result=? WHERE operation_id=?", []byte("{corrupt"), bad.OperationID); err != nil {
+		t.Fatal(err)
+	}
+	good := f.input(t, "good-result", "b")
+	codes := batchStatuses(t, batchRequest(t, f, ctx, []MessageInput{bad, good}, true))
+	if fmt.Sprint(codes) != "[503 201]" {
+		t.Fatal(codes)
+	}
+	// Storage query errors cannot turn into authoritative dedup misses.
+	if _, err := f.c.DB.Exec("DROP TABLE operations"); err != nil {
+		t.Fatal(err)
+	}
+	snapshot := f.c.loadBatchPrepare(ctx, f.id, "chat", []MessageInput{good})
+	if snapshot.operationsErr == nil {
+		t.Fatal("missing SQL error")
+	}
+	if job, _, err := f.c.prepareMessageWithSnapshot(ctx, f.id, "chat", good, snapshot); err == nil || job != nil {
+		t.Fatal(job, err)
+	}
+}
+
+func TestBatchPrepareHooksRemainSequential(t *testing.T) {
+	for _, transactional := range []bool{false, true} {
+		t.Run(fmt.Sprint(transactional), func(t *testing.T) {
+			f := newFixture(t)
+			ctx := context.Background()
+			calls := 0
+			if transactional {
+				f.c.InTransaction = append(f.c.InTransaction, func(ctx context.Context, tx *sql.Tx, _ Identity, _ string, _ Message) error { calls++; return nil })
+			} else {
+				f.c.Prepare = append(f.c.Prepare, func(ctx context.Context, _ Identity, _ string, _ *MessageInput) error {
+					calls++
+					if calls == 1 {
+						_, err := f.c.DB.ExecContext(ctx, "UPDATE members SET can_send=0 WHERE user_id='alice'")
+						return err
+					}
+					return nil
+				})
+			}
+			codes := batchStatuses(t, batchRequest(t, f, ctx, []MessageInput{f.input(t, "hook-a", "a"), f.input(t, "hook-b", "b")}, true))
+			if transactional {
+				if fmt.Sprint(codes) != "[201 201]" || calls != 2 {
+					t.Fatal(codes, calls)
+				}
+			} else if fmt.Sprint(codes) != "[403 403]" || calls != 1 {
+				t.Fatal(codes, calls)
+			}
+		})
+	}
+}
+
+func TestBatchPrepareHookGroupBoundaryOrdering(t *testing.T) {
+	f := newFixture(t)
+	calls := 0
+	f.c.Prepare = append(f.c.Prepare, func(ctx context.Context, _ Identity, _ string, _ *MessageInput) error {
+		calls++
+		if calls == maxWriteBatch+1 {
+			var seq int
+			if err := f.c.DB.QueryRowContext(ctx, "SELECT seq FROM chats WHERE id='chat'").Scan(&seq); err != nil {
+				return err
+			}
+			if seq != 0 {
+				return fmt.Errorf("legacy preparation ordering changed: seq=%d", seq)
+			}
+		}
+		return nil
+	})
+	inputs := make([]MessageInput, maxWriteBatch+1)
+	for i := range inputs {
+		inputs[i] = f.input(t, fmt.Sprint("hook-boundary-", i), "hello")
+	}
+	codes := batchStatuses(t, batchRequest(t, f, context.Background(), inputs, true))
+	for _, code := range codes {
+		if code != 201 {
+			t.Fatal(codes)
+		}
+	}
+}
