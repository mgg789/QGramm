+//go:build qg_bench_profile
+
+package core
+
+import (
+	"context"
+	"fmt"
+	"testing"
+)
+
+func TestBatchPrepareBoundedReadCount(t *testing.T) {
+	f := newFixture(t)
+	inputs := make([]MessageInput, 34)
+	for i := range inputs {
+		inputs[i] = f.input(t, fmt.Sprint("bounded-", i), "hello")
+	}
+	before := f.c.diagnostics.reads.Load()
+	codes := batchStatuses(t, batchRequest(t, f, context.Background(), inputs, true))
+	for _, code := range codes {
+		if code != 201 {
+			t.Fatal(codes)
+		}
+	}
+	if reads := f.c.diagnostics.reads.Load() - before; reads != 6 {
+		t.Fatalf("preliminary reads %d want 6 for 3 bounded windows", reads)
+	}
+}
