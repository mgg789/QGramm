+package core
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+)
+
+type batchPreviousOperation struct {
+	hash   string
+	result []byte
+}
+
+// This bounded, request-local snapshot avoids repeated preliminary reads only.
+// The writer still checks access, epoch, pending state and dedup in its transaction.
+type batchPrepareSnapshot struct {
+	operations       map[string]batchPreviousOperation
+	operationsErr    error
+	mode             string
+	epoch            int64
+	pending, canSend bool
+	accessErr        error
+}
+
+func (s *batchPrepareSnapshot) operation(id string) (string, []byte, error) {
+	if s.operationsErr != nil {
+		return "", nil, s.operationsErr
+	}
+	if previous, ok := s.operations[id]; ok {
+		return previous.hash, previous.result, nil
+	}
+	return "", nil, sql.ErrNoRows
+}
+
+func (c *Core) loadBatchPrepare(ctx context.Context, id Identity, chat string, inputs []MessageInput) *batchPrepareSnapshot {
+	s := &batchPrepareSnapshot{operations: make(map[string]batchPreviousOperation)}
+	args := []any{id.DeviceID}
+	seen := make(map[string]bool)
+	for _, input := range inputs {
+		if validID(input.OperationID) && !seen[input.OperationID] {
+			seen[input.OperationID] = true
+			args = append(args, input.OperationID)
+		}
+	}
+	if len(args) > 1 {
+		query := `SELECT operation_id,hash,result FROM operations WHERE device_id=? AND operation_id IN (` + strings.TrimSuffix(strings.Repeat("?,", len(args)-1), ",") + `)`
+		rows, err := c.readQuery(ctx, query, args...)
+		if err == nil {
+			for rows.Next() {
+				var op string
+				var previous batchPreviousOperation
+				if err = rows.Scan(&op, &previous.hash, &previous.result); err != nil {
+					break
+				}
+				s.operations[op] = previous
+			}
+			if err == nil {
+				err = rows.Err()
+			}
+			rows.Close()
+		}
+		s.operationsErr = err
+	}
+	if s.operationsErr == nil {
+		s.accessErr = c.readQueryRow(ctx, `SELECT c.mode,c.epoch,c.pending,m.can_send FROM chats c JOIN members m ON m.chat_id=c.id JOIN devices d ON d.user_id=m.user_id JOIN users u ON u.id=m.user_id WHERE c.id=? AND m.user_id=? AND d.id=? AND m.active=1 AND d.revoked=0 AND u.disabled=0`, chat, id.UserID, id.DeviceID).Scan(&s.mode, &s.epoch, &s.pending, &s.canSend)
+	}
+	return s
+}
